font-family="JetBrainsMonoNL Nerd Font Propo"
font-size="17.5"
theme="Spacegray Eighties Dull"
cursor-opacity="0.5"
background-opacity="0.5"
background-blur="true"
title="prdai's ghostty"
window-decoration="auto"
window-title-font-family="JetBrainsMonoNL Nerd Font Propo"
window-theme="dark"
quick-terminal-position="center"
shell-integration="zsh"
macos-titlebar-style="transparent"
auto-update="download"
gtk-titlebar = false
cursor-style = block
cursor-style-blink = true
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+a>t=new_tab
keybind = ctrl+a>w=close_surface
keybind = ctrl+one=goto_tab:1
keybind = ctrl+two=goto_tab:2
keybind = ctrl+three=goto_tab:3
keybind = ctrl+four=goto_tab:4
keybind = ctrl+five=goto_tab:5
keybind = ctrl+six=goto_tab:6
keybind = ctrl+seven=goto_tab:7
keybind = ctrl+eight=goto_tab:8
keybind = ctrl+nine=goto_tab:9
custom-shader = ./ghostty-shaders/cursor_sweep.glsl
