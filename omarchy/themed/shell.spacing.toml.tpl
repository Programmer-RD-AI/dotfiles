# Omarchy user template: spacing.
#
# Section override replacing [spacing]. waybar's module groups were 30px tall
# with 5px horizontal padding inside a 40px bar, which reads roomier than
# herdr's defaults once [font] base-size is raised to 14.
#
# scale-with-font is off so these stay put instead of drifting with base-size.

[spacing]
scale = 1.0
scale-with-font = false

control-height    = 30
control-padding-x = 10
control-gap       = 8
