{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "codexSurface": "#181818",
    "codexPanel": "#1e1e1e",
    "codexElement": "#242424",
    "codexBorder": "#2a2a2a",
    "codexAccent": "#83c3ff",
    "codexAccentHi": "#a8d4ff",
    "codexInk": "#ffffff",
    "codexMuted": "#969696",
    "codexError": "#ff6764",
    "codexWarn": "#ff8549",
    "codexOk": "#5fbf78",
    "codexOneRed": "#e06c75",
    "codexOneGreen": "#98c379",
    "codexOneYellow": "#e5c07b",
    "codexOneBlue": "#61afef"
  },
  "theme": {
    "primary": { "dark": "codexAccent", "light": "codexAccent" },
    "secondary": { "dark": "codexAccentHi", "light": "codexAccent" },
    "accent": { "dark": "codexAccent", "light": "codexAccent" },
    "error": { "dark": "codexError", "light": "codexError" },
    "warning": { "dark": "codexWarn", "light": "codexWarn" },
    "success": { "dark": "codexOk", "light": "codexOk" },
    "info": { "dark": "codexAccent", "light": "codexAccent" },
    "text": { "dark": "codexInk", "light": "#0d0d0d" },
    "textMuted": { "dark": "codexMuted", "light": "#666666" },
    "background": { "dark": "codexSurface", "light": "#ffffff" },
    "backgroundPanel": { "dark": "codexPanel", "light": "#f5f5f5" },
    "backgroundElement": { "dark": "codexElement", "light": "#ececec" },
    "border": { "dark": "codexBorder", "light": "#d4d4d4" },
    "borderActive": { "dark": "codexAccent", "light": "codexAccent" },
    "borderSubtle": { "dark": "#212121", "light": "#e0e0e0" },
    "diffAdded": { "dark": "codexOneGreen", "light": "codexOneGreen" },
    "diffRemoved": { "dark": "codexOneRed", "light": "codexOneRed" },
    "diffContext": { "dark": "#555555", "light": "#999999" },
    "diffHunkHeader": { "dark": "codexAccent", "light": "codexAccent" },
    "diffHighlightAdded": { "dark": "codexOk", "light": "codexOk" },
    "diffHighlightRemoved": { "dark": "codexError", "light": "codexError" },
    "diffAddedBg": { "dark": "#14261c", "light": "#e6f4ea" },
    "diffRemovedBg": { "dark": "#2a1719", "light": "#fbe7e8" },
    "diffContextBg": { "dark": "codexPanel", "light": "#f5f5f5" },
    "diffLineNumber": { "dark": "#555555", "light": "#999999" },
    "diffAddedLineNumberBg": { "dark": "#14261c", "light": "#e6f4ea" },
    "diffRemovedLineNumberBg": { "dark": "#2a1719", "light": "#fbe7e8" },
    "markdownText": { "dark": "codexInk", "light": "#0d0d0d" },
    "markdownHeading": { "dark": "codexAccentHi", "light": "codexAccent" },
    "markdownLink": { "dark": "codexAccent", "light": "codexAccent" },
    "markdownLinkText": { "dark": "codexAccent", "light": "codexAccent" },
    "markdownCode": { "dark": "codexOneGreen", "light": "codexOneGreen" },
    "markdownBlockQuote": { "dark": "codexMuted", "light": "#666666" },
    "markdownEmph": { "dark": "codexWarn", "light": "codexWarn" },
    "markdownStrong": { "dark": "codexOneYellow", "light": "codexOneYellow" },
    "markdownHorizontalRule": { "dark": "codexBorder", "light": "#d4d4d4" },
    "markdownListItem": { "dark": "codexAccentHi", "light": "codexAccent" },
    "markdownListEnumeration": { "dark": "codexAccentHi", "light": "codexAccent" },
    "markdownImage": { "dark": "codexAccent", "light": "codexAccent" },
    "markdownImageText": { "dark": "codexAccentHi", "light": "codexAccent" },
    "markdownCodeBlock": { "dark": "codexInk", "light": "#0d0d0d" },
    "syntaxComment": { "dark": "#6b6b6b", "light": "#8a8a8a" },
    "syntaxKeyword": { "dark": "codexOneRed", "light": "codexOneRed" },
    "syntaxFunction": { "dark": "codexOneBlue", "light": "codexOneBlue" },
    "syntaxVariable": { "dark": "codexOneRed", "light": "codexOneRed" },
    "syntaxString": { "dark": "codexOneGreen", "light": "codexOneGreen" },
    "syntaxNumber": { "dark": "codexOneYellow", "light": "codexOneYellow" },
    "syntaxType": { "dark": "codexOneYellow", "light": "codexOneYellow" },
    "syntaxOperator": { "dark": "codexOneRed", "light": "codexOneRed" },
    "syntaxPunctuation": { "dark": "codexInk", "light": "#0d0d0d" }
  }
}
