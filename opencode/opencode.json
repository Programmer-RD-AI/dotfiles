{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-luna",
  "small_model": "opencode-go/deepseek-v4-flash",
  "autoupdate": true,
  "share": "disabled",
  "snapshot": true,
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git fetch *": "allow",
      "git pull *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "env": "allow"
    },
    "external_directory": {
      "*": "ask",
      "~/Storage/**": "allow"
    }
  }
}
